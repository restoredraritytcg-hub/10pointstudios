# Public contact destination. Not a secret: the same address is printed on the site.
# Leave unset and the form falls back to mailto:10pointstudios@protonmail.com.
# Production builds in this repo set a keyless FormSubmit endpoint (see .env.production).
# Override here, or in the host's build environment, if the inbox changes.
NEXT_PUBLIC_CONTACT_ENDPOINT=https://formsubmit.co/ajax/10pointstudios@protonmail.com
