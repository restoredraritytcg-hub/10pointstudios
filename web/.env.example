# Public contact destination. Not a secret: the same address is printed on the site.
# Leave unset and the build uses the keyless FormSubmit endpoint for the studio
# address (DEFAULT_CONTACT_ENDPOINT in lib/site.ts). Env files are not committed;
# copy this to .env.local, or set it in the build environment, to override it
# (for example with the FormSubmit random-string alias).
NEXT_PUBLIC_CONTACT_ENDPOINT=https://formsubmit.co/ajax/10pointstudios@protonmail.com

# Optional. FormSubmit _cc mailbox. Unset keeps the default in lib/site.ts.
# Set to an empty value once the studio inbox forwards there, and the CC
# address drops out of the public JavaScript.
# NEXT_PUBLIC_CONTACT_CC=
