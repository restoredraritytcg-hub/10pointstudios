# Public, keyless FormSubmit endpoint. No API key. The address is already on the site.
# The first submission emails an activation link to 10pointstudios@protonmail.com.
# Click that link once. Until then FormSubmit holds messages, then delivers them.
NEXT_PUBLIC_CONTACT_ENDPOINT=https://formsubmit.co/ajax/10pointstudios@protonmail.com
